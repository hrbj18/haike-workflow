# haike-videohub —— 装配仓库
#
# 本仓库只放「契约 + 步骤 + 验证」，不放代码，也不放任何运行产物。
# 下面按「一定不能提交」的优先级排列。

# ---------------------------------------------------------------- 密钥（最高优先级）
.env
.env.*
!.env.example
*.env
config.yaml
gcp-*.json
*-service-account.json
*.pem
*.key

# ---------------------------------------------------------------- 运行产物
# 假数据由 verify/make_fixtures.py 生成，不入库
fixtures/
output/
logs/
cache/
temp/
renders/
projects/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- Node
node_modules/
dist/
build/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 临时与证据
_diag/
*.log
*.tmp
_*.txt
_*.json
_*.py
_*.cmd
!verify/check_all.py
!verify/make_fixtures.py

# ---------------------------------------------------------------- WorkBuddy 项目数据
# 注意：.workbuddy 不是临时缓存，是项目数据；只是不该跨机复制
.workbuddy/

# ---------------------------------------------------------------- 大文件
*.onnx
*.mp4
*.mov
*.mkv
*.wav
*.mp3
