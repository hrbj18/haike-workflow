{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haike:video-template-spec:v1",
  "title": "Video template authoring specification v1",
  "description": "Authoring and review contract, not a renderer input schema. Paths are relative to the specification file. Example declarations do not certify rendered media.",
  "type": "object",
  "required": [
    "schema_version",
    "standard_version",
    "template_id",
    "template_version",
    "template_type",
    "spec_kind",
    "stage",
    "authority",
    "canvas",
    "narrative",
    "scenes",
    "assets",
    "elements",
    "slots",
    "evidence",
    "unknowns",
    "validation",
    "extensions",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "standard_version": {
      "const": "video-template-v1"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "template_type": {
      "enum": [
        "avatar",
        "graphic",
        "chart",
        "tutorial",
        "material_edit",
        "custom"
      ]
    },
    "spec_kind": {
      "enum": [
        "reference",
        "implementation"
      ]
    },
    "stage": {
      "enum": [
        "specification",
        "ready"
      ]
    },
    "authority": {
      "type": "object",
      "required": [
        "runbook",
        "implementation_paths",
        "parameter_source"
      ],
      "properties": {
        "runbook": {
          "type": "string",
          "minLength": 1
        },
        "implementation_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameter_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "duration_seconds",
        "clock",
        "coordinate_system"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_system": {
          "const": "top_left_pixels"
        }
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "required": [
        "purpose",
        "information_hierarchy",
        "structure"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "information_hierarchy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      },
      "minItems": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved"
      },
      "minItems": 0
    },
    "validation": {
      "type": "object",
      "required": [
        "structure",
        "technical",
        "visual",
        "audio",
        "platform",
        "user_review",
        "production"
      ],
      "properties": {
        "structure": {
          "$ref": "#/$defs/gate"
        },
        "technical": {
          "$ref": "#/$defs/gate"
        },
        "visual": {
          "$ref": "#/$defs/gate"
        },
        "audio": {
          "$ref": "#/$defs/gate"
        },
        "platform": {
          "$ref": "#/$defs/gate"
        },
        "user_review": {
          "$ref": "#/$defs/gate"
        },
        "production": {
          "$ref": "#/$defs/gate"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "minProperties": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "evidence_plan"
      ],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_plan": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "evidence_ids",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "path",
        "source",
        "embedded_content",
        "rights_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "font",
            "image",
            "video",
            "audio",
            "vector",
            "data",
            "generated",
            "other"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "embedded_content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rights_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "start",
        "end",
        "purpose",
        "element_ids",
        "variant"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "element_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "minItems": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "id",
        "visible",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "visible": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "from",
        "to",
        "trigger",
        "start",
        "end",
        "properties",
        "easing"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "easing": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": [
        "kind",
        "target_id",
        "rule"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "role",
        "parent_id",
        "z_index",
        "content",
        "layout",
        "timing",
        "states",
        "transitions",
        "constraints",
        "fixed",
        "replaceable",
        "evidence_ids",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "z_index": {
          "type": "integer"
        },
        "content": {
          "type": "object",
          "required": [
            "mode",
            "binding",
            "asset_id",
            "description"
          ],
          "properties": {
            "mode": {
              "enum": [
                "editable",
                "embedded",
                "generated",
                "none"
              ]
            },
            "binding": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "asset_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "required": [
            "coordinate_space",
            "anchor",
            "box",
            "fit",
            "clip",
            "style"
          ],
          "properties": {
            "coordinate_space": {
              "enum": [
                "canvas",
                "parent"
              ]
            },
            "anchor": {
              "enum": [
                "top_left",
                "top_center",
                "top_right",
                "center_left",
                "center",
                "center_right",
                "bottom_left",
                "bottom_center",
                "bottom_right"
              ]
            },
            "box": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "$ref": "#/$defs/unknown"
                }
              ]
            },
            "fit": {
              "enum": [
                "contain",
                "cover",
                "none"
              ]
            },
            "clip": {
              "enum": [
                "none",
                "parent",
                "self"
              ]
            },
            "style": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "required": [
            "relative_to",
            "start",
            "end"
          ],
          "properties": {
            "relative_to": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/unknown"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/unknown"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "minItems": 0
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replaceable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "method",
              "pass_condition"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "pass_condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "id",
        "element_id",
        "property",
        "value_type",
        "required",
        "limits",
        "missing",
        "overflow"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "asset",
            "array",
            "object"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "limits": {
          "type": "object"
        },
        "missing": {
          "type": "string",
          "minLength": 1
        },
        "overflow": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "source_kind",
        "source",
        "locator",
        "method",
        "file",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "source_kind": {
          "enum": [
            "observation",
            "measurement",
            "design",
            "illustrative"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": [
        "path",
        "reason",
        "evidence_plan",
        "blocks"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_plan": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "enum": [
              "execution",
              "structure",
              "technical",
              "visual",
              "audio",
              "platform",
              "user_review",
              "production"
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "input",
        "action",
        "output",
        "completion",
        "recovery",
        "entrypoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
