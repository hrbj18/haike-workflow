{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "haike.motion-public-dark-remotion-input/2",
  "title": "保留原Remotion的完整深色十组本期输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "pack_key",
    "reference_id",
    "title",
    "brand",
    "script",
    "asr",
    "assets",
    "composition",
    "source_receipts",
    "tool_root",
    "dependency_root",
    "ffmpeg_root"
  ],
  "properties": {
    "engine": {
      "const": "dark-remotion/2"
    },
    "pack_key": {
      "const": "owned-dark-cobalt"
    },
    "reference_id": {
      "const": "template-03-native"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "script": {
      "$ref": "#/$defs/file"
    },
    "asr": {
      "$ref": "#/$defs/file"
    },
    "assets": {
      "type": "object",
      "required": [
        "voice.wav",
        "music.wav",
        "presenter.mp4"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "props",
        "audio",
        "display_aliases"
      ],
      "properties": {
        "preview_scope": {
          "enum": [
            "full-actions/1",
            "readiness-probe/1"
          ],
          "default": "full-actions/1"
        },
        "props": {
          "type": "object",
          "required": [
            "variant",
            "width",
            "height",
            "fps",
            "durationFrames",
            "fontAssets",
            "media",
            "scenes",
            "captions",
            "presenter"
          ],
          "properties": {
            "variant": {
              "const": "cobalt"
            },
            "width": {
              "const": 1440
            },
            "height": {
              "const": 1800
            },
            "fps": {
              "const": 30
            },
            "durationFrames": {
              "type": "integer",
              "minimum": 1
            },
            "scenes": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10
            },
            "captions": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice",
            "music",
            "musicGainDb",
            "musicOffsetSeconds",
            "loopMusic",
            "sfx"
          ],
          "properties": {
            "voice": {
              "const": "voice.wav"
            },
            "music": {
              "const": "music.wav"
            },
            "musicGainDb": {
              "type": "number",
              "minimum": -40,
              "maximum": -8
            },
            "musicOffsetSeconds": {
              "const": 0
            },
            "loopMusic": {
              "const": true
            },
            "sfx": {
              "const": []
            }
          }
        },
        "display_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "expected_count"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "expected_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "source_receipts": {
      "type": "object"
    },
    "tool_root": {
      "type": "string",
      "minLength": 1
    },
    "dependency_root": {
      "type": "string",
      "minLength": 1
    },
    "ffmpeg_root": {
      "type": "string",
      "minLength": 1
    },
    "work_root": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$comment": "Structural schema only. The fixed consumer also checks complete groups/cues/read time, implemented content fields, every actual word boundary, source identity/coverage, exact fonts and the executable closure. This is not a runnable default input."
}
