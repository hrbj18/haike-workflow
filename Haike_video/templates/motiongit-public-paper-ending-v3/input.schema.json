{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "haike.motion-public-paper-observed-input/3",
  "title": "纸感末场退出候选v3完整输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "pack_key",
    "reference_id",
    "title",
    "script",
    "asr",
    "assets",
    "composition",
    "tool_root",
    "dependency_root"
  ],
  "properties": {
    "engine": {
      "const": "observed-paper-controls/3"
    },
    "pack_key": {
      "const": "observed-paper"
    },
    "reference_id": {
      "const": "template-02-expanded"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string"
    },
    "script": {
      "$ref": "#/$defs/file"
    },
    "asr": {
      "$ref": "#/$defs/file"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "voice.wav"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_timeline": {
          "type": "object",
          "required": [
            "duration"
          ],
          "properties": {
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "layout": {
              "const": "portrait"
            }
          }
        },
        "semantic_scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "action_id",
              "sentence_start",
              "sentence_end",
              "props",
              "variant",
              "cues"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "action_id": {
                "type": "string"
              },
              "sentence_start": {
                "type": "integer",
                "minimum": 0
              },
              "sentence_end": {
                "type": "integer",
                "minimum": 1
              },
              "variant": {
                "type": "string"
              },
              "props": {
                "type": "object"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "presenter": {
                "enum": [
                  "hide",
                  "card"
                ]
              },
              "start_in_silence": {
                "type": "number",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action_id": {
                      "pattern": "\\.quote$"
                    }
                  },
                  "required": [
                    "action_id"
                  ]
                },
                "then": {
                  "properties": {
                    "props": {
                      "$ref": "#/$defs/quote"
                    }
                  }
                }
              }
            ]
          }
        },
        "timeline": {
          "type": "object",
          "required": [
            "duration",
            "segments"
          ],
          "properties": {
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "t0",
                  "t1",
                  "control",
                  "variant",
                  "props",
                  "cues"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "control": {
                          "const": "quote"
                        }
                      },
                      "required": [
                        "control"
                      ]
                    },
                    "then": {
                      "properties": {
                        "props": {
                          "$ref": "#/$defs/quote"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "caption_corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "expected_count"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string"
              },
              "expected_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "base_timeline",
            "semantic_scenes"
          ],
          "not": {
            "required": [
              "timeline"
            ]
          }
        },
        {
          "required": [
            "timeline"
          ],
          "not": {
            "required": [
              "semantic_scenes"
            ]
          }
        }
      ]
    },
    "source_receipts": {
      "type": "object"
    },
    "tool_root": {
      "type": "string",
      "minLength": 1
    },
    "dependency_root": {
      "type": "string",
      "minLength": 1
    },
    "ffmpeg_root": {
      "type": "string",
      "minLength": 1
    },
    "work_root": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 50
        },
        "who": {
          "type": "string",
          "maxLength": 40
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  },
  "$comment": "Structural v2 schema. Only poster quote supports optional explicit lines, whose exact concatenation must equal text; fixed consumer checks style/control types, unchanged measured ASR/source clocks and complete content. No complete distributable default fixture is claimed."
}
