[Unit]
Description=Haike API account and billing backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haike-api
Group=haike-api
WorkingDirectory=/opt/haike-api-platform/current
ExecStart=/opt/haike-api-platform/current/.venv/bin/python run.py --port 17895 --db /var/lib/haike-api-platform/platform.sqlite3 --public-origin https://8.138.207.71:17894
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
StateDirectory=haike-api-platform
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/haike-api-platform
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
